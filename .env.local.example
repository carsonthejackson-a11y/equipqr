# Copy this file to .env.local and fill in real values. Never commit .env.local.
# See README.md "Environment variables" for where to get each one, and
# src/lib/env.ts for how they're validated at runtime.

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API in your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project Settings -> API -> service_role secret. Bypasses RLS. Used only by
# src/lib/supabase/admin.ts (the Stripe webhook route), never by client code.
# Also required for /api/v1/* (the public API) and API key auth in general —
# see docs/API.md — since those requests have no Supabase session to scope
# RLS by and rely entirely on the service-role client filtered by company id.
SUPABASE_SERVICE_ROLE_KEY=

# --- App URL (required, has a sane local default) --------------------------
# Used to build public QR / email links and Stripe Checkout/Portal redirects.
# Set to your production domain when deploying (e.g. https://app.equipqr.com).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown to customers on public pages as a contact address (optional).
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Feature flags -----------------------------------------------------------
# Pre-printed QR sticker batches (admin-generated codes that companies claim).
# Off by default for launch; set to "true" to bring the feature back.
NEXT_PUBLIC_FEATURE_BATCH_QR=false

# --- Email via Resend (optional; emails are skipped if unset) ---------------
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be on a domain verified in Resend (https://resend.com/domains).
RESEND_FROM_EMAIL=

# --- AI guide drafting + chat via Anthropic (optional) ----------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Billing via Stripe (optional) ------------------------------------------
# See docs/BILLING.md for how to set up the Stripe dashboard side of this.
# The app degrades gracefully without these set: the billing page shows a
# "Stripe not configured" note and disables checkout/portal, but everything
# else (trial tracking, equipment limits, feature gating) still works.

# https://dashboard.stripe.com/apikeys  (sk_test_... / sk_live_...)
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/webhooks — signing secret (whsec_...) for the
# /api/stripe/webhook endpoint.
STRIPE_WEBHOOK_SECRET=

# Price ids for each plan/interval — create these in the Stripe dashboard
# (3 products x 2 prices each) and paste their price ids (price_...) below.
# Keep these in sync with the plan data in src/lib/plans.ts.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# --- Error tracking via Sentry (optional; app runs fine with this unset) ---
# https://sentry.io -> Settings -> Projects -> <project> -> Client Keys (DSN)
SENTRY_DSN=

# --- Cron authentication (required to run scheduled jobs) -------------------
# Shared secret checked against the `Authorization: Bearer <CRON_SECRET>`
# header Vercel Cron sends. Generate any long random string. Without it,
# src/app/api/cron/* routes reject every request (fail closed) — the daily
# trial-reminder job just silently never sends anything, so set this in any
# environment where vercel.json's cron schedule is actually running.
CRON_SECRET=
