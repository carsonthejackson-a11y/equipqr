# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses RLS. Used only by src/lib/supabase/admin.ts
# (the Stripe webhook route), never by client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- App ----------------------------------------------------------------------
# Absolute base URL of this app (e.g. http://localhost:3000 in dev). Required
# for Stripe Checkout/Portal redirect URLs.
NEXT_PUBLIC_APP_URL=

# --- AI (Anthropic) ------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Stripe billing --------------------------------------------------------
# See docs/BILLING.md for how to set up the Stripe dashboard side of this.
# The app degrades gracefully without these set: the billing page shows a
# "Stripe not configured" note and disables checkout/portal, but everything
# else (trial tracking, equipment limits, feature gating) still works.

# Secret key (sk_test_... / sk_live_...).
STRIPE_SECRET_KEY=

# Signing secret for the /api/stripe/webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Publishable key (pk_test_... / pk_live_...) — optional; not currently used
# by any client-side Stripe.js code, but documented here in case that's added.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Price ids for each plan/interval — create these in the Stripe dashboard
# (3 products x 2 prices each) and paste their price ids (price_...) below.
# Keep these in sync with the plan data in src/lib/plans.ts.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
