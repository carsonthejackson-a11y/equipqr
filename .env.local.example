# Copy this file to .env.local and fill in real values.
# See README.md "Environment variables" for where to get each one, and
# src/lib/env.ts for how they're validated at runtime.

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API in your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project Settings -> API -> service_role secret. Only needed for
# server-side scripts that must bypass RLS; the app itself runs on the
# anon key + RLS. Keep this out of anything client-facing.
SUPABASE_SERVICE_ROLE_KEY=

# --- App URL (required, has a sane local default) --------------------------
# Used to build public QR / email links. Set to your production domain when
# deploying (e.g. https://app.equipqr.com).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown to customers on public pages as a contact address (optional).
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Email via Resend (optional; service-request emails are skipped if unset) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be on a domain verified in Resend (https://resend.com/domains).
RESEND_FROM_EMAIL=

# --- AI guide drafting + chat via Anthropic (optional) ----------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Billing via Stripe (optional) ------------------------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/webhooks — the signing secret for the
# endpoint you configure.
STRIPE_WEBHOOK_SECRET=

# --- Error tracking via Sentry (optional; app runs fine with this unset) ---
# https://sentry.io -> Settings -> Projects -> <project> -> Client Keys (DSN)
SENTRY_DSN=
